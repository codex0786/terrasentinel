# Copy to .env and fill in. Never commit .env.
# Free key: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=
# Earthdata Login (https://urs.earthdata.nasa.gov) — needed for IMERG / MODIS / SMAP later.
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
# Where the immutable raw archive lives (outside Git for large data).
TERRASENTINEL_DATA_DIR=./data
